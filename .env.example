# Copied to /docker/sly-crm/.env on the VPS (docker-compose reads it via env_file).
# Not committed — see .gitignore.

# Resend API key (https://resend.com) — required for birthday email automation.
# Without it, the app runs fine but automation stays off (see the Automation tab).
RESEND_API_KEY=

# "Name <email@domain>" — the from-address for automated emails. Must be on a
# domain verified in Resend for production sending; the Resend sandbox address
# (onboarding@resend.dev) only delivers to the account owner's own inbox.
EMAIL_FROM=SLY <onboarding@resend.dev>
