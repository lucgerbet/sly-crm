# Copied to /docker/sly-crm/.env on the VPS (docker-compose reads it via env_file).
# Not committed — see .gitignore.

# Resend API key (https://resend.com) — required for birthday email automation.
# Without it, the app runs fine but automation stays off (see the Automation tab).
RESEND_API_KEY=

# "Name <email@domain>" — the from-address for automated emails. Must be on a
# domain verified in Resend for production sending; the Resend sandbox address
# (onboarding@resend.dev) only delivers to the account owner's own inbox.
EMAIL_FROM=SLY <onboarding@resend.dev>

# Stripe — same account sly-shop already uses. Required for creating balance
# Payment Links (orders/finalize) and verifying webhook signatures.
STRIPE_SECRET_KEY=
# From the Stripe Dashboard's webhook endpoint config, once one is created
# pointing at https://sly-crm.srv1758374.hstgr.cloud/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Shared secret for server-to-server calls sly-shop makes into this CRM
# (order intake, appointment booking from the Calendly widget, and later the
# order-taking tool). Generate a long random string; set the SAME value in
# sly-shop's Vercel environment variables. Not the human Basic Auth password —
# deliberately separate so rotating one never breaks the other.
SLY_INTAKE_SECRET=

# Calendly Personal Access Token — Calendly's account (free plan, no
# webhooks) → Integrations → API & Webhooks → "Get a token now" /
# "Generate new token". Used to resolve the real appointment start/end time
# server-side after the widget's `event_scheduled` postMessage fires, since
# that event only ever carries the event URI, never a date/time.
CALENDLY_API_TOKEN=
